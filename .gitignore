# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
.ipynb_checkpoints/

# Raw data: PII-bearing and licence-restricted. Rebuild with data/download_data.py.
data/raw/*
!data/raw/.gitkeep

# Modern pool: processed text from unclear-licence sources stays local.
# The text-free manifest, folds and audit are committed.
data/processed/modern/train.csv
data/processed/modern/cal.csv
data/processed/modern/test.csv
data/processed/review/

# UCI anchor splits: text-bearing, rebuilt locally by make setup. The data
# card and its attribution stay committed.
data/processed/uci/train.csv
data/processed/uci/cal.csv
data/processed/uci/test.csv

# Gold holdout: synthetic, but the evaluation set. Local-only, never
# committed and never distributed. Rebuild with data/build_gold.py.
data/gold_holdout*.csv

# Real-alert evaluation set and its report: local-only, never committed.
data/local/
reports/results/real_alerts.json

# Model artefacts and checkpoints (regenerate; never commit weights)
artifacts/*
!artifacts/.gitkeep
models/
*.joblib
*.pt
*.bin
*.safetensors
*.onnx

# Reports are committed, but keep generated junk out
reports/figures/*.tmp
.pytest_cache/
.ruff_cache/
.DS_Store

# Session exports: never commit
session-*.md
